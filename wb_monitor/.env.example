# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-your-token

# Твой личный chat_id (технические алерты идут сюда). Узнать: @userinfobot
ADMIN_CHAT_ID=0

# Путь к файлу SQLite (по умолчанию wb_monitor/wb_monitor.db)
#DB_PATH=/opt/wb_monitor/wb_monitor.db

# Расписание job'ов
PARSE_INTERVAL_HOURS=4
REPORT_WEEKDAY=mon
REPORT_HOUR=8
HEALTH_CHECK_HOUR=9

# Парсер
REQUEST_DELAY_MIN=0.5
REQUEST_DELAY_MAX=1.5
REQUEST_TIMEOUT=10
REQUEST_RETRIES=3
# Прокси не нужен на старте; когда понадобится — просто раскомментируй:
#PROXY_URL=http://user:pass@host:port
