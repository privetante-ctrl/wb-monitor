# Этот файл — образец. Сам .env создаётся автоматически при первом
# запуске ./start.sh — руками сюда лезть не нужно.

# Токен бота от @BotFather (единственное, что спрашивается при настройке)
BOT_TOKEN=123456:ABC-your-token

# Chat_id для технических алертов.
# 0 = бот запомнит первого, кто нажмёт /start. Заполняй, только если
# хочешь жёстко закрепить админский чат.
ADMIN_CHAT_ID=0

# Путь к файлу SQLite (по умолчанию wb_monitor/wb_monitor.db)
#DB_PATH=/opt/wb_monitor/wb_monitor.db

# Расписание job'ов
PARSE_INTERVAL_HOURS=4
REPORT_WEEKDAY=mon
REPORT_HOUR=8
HEALTH_CHECK_HOUR=9

# Парсер
REQUEST_DELAY_MIN=0.5
REQUEST_DELAY_MAX=1.5
REQUEST_TIMEOUT=10
REQUEST_RETRIES=3
# Прокси не нужен на старте; когда понадобится — просто раскомментируй:
#PROXY_URL=http://user:pass@host:port
