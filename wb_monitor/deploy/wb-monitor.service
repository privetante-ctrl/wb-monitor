# systemd-юнит: держать сервис поднятым на VPS.
# На своём компьютере он не нужен — там достаточно ./start.sh
# Установка: см. README.md, раздел «Если хочется на сервер».
[Unit]
Description=WB competitor monitor (bot + scheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wbmon
WorkingDirectory=/opt/wb-monitor
# то же окружение, что создаёт start.sh — отдельный venv заводить не нужно
ExecStart=/opt/wb-monitor/.venv/bin/python wb_monitor/cli.py run
Restart=always
RestartSec=10
# .env лежит в wb_monitor/ рядом с config.py — он подхватит его сам

# журналирование в journald
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
